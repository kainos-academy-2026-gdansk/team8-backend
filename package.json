{
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"argon2": "^0.45.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.11.0",
		"pg": "^8.22.0",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"name": "team8-backend",
	"version": "1.0.0",
	"description": "Team8 Backend",
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "tsx ./dist/index.js",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"lint:format": "biome format --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:bdd": "bddgen && playwright test",
		"test:bdd:mocked": "bddgen && playwright test --project=api-mocked",
		"test:bdd:integration": "bddgen && playwright test --project=api-integration",
		"test:bdd:keep-db": "BDD_KEEP_DB=1 npm run test:bdd",
		"db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
		"db:test:prepare": "if [ \"$BDD_EXTERNAL_DB\" != \"1\" ]; then npm run db:test:up; fi; npx prisma migrate deploy",
		"db:test:down": "docker compose -f docker-compose.test.yml down -v"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kainos-academy-2026-gdansk/team8-backend.git"
	},
	"keywords": [],
	"type": "module",
	"bugs": {
		"url": "https://github.com/kainos-academy-2026-gdansk/team8-backend/issues"
	},
	"homepage": "https://github.com/kainos-academy-2026-gdansk/team8-backend#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@playwright/test": "^1.62.1",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.20.4",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"playwright-bdd": "^9.2.0",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"tsx": "^4.23.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
